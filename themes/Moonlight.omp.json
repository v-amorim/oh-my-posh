{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": true,
  "shell_integration": true,
  "streaming": 100,
  "palette": {
    "git_branch_divergence": "p:terminal_pink",
    "git_changes_pending": "p:terminal_blue",
    "git_commits_ahead": "p:terminal_brightgray",
    "git_commits_behind": "p:terminal_lightblue",
    "main_background": "#1E2336",
    "secondary_background": "#272D44",
    "terminal_blue": "#5DABF3",
    "terminal_bluegray": "#acb9e6",
    "terminal_brightgray": "#ced9ff",
    "terminal_error": "#CA5F71",
    "terminal_gray": "#AEA4BF",
    "terminal_green": "#49EF95",
    "terminal_lightblue": "#7386d0",
    "terminal_lightgray": "#cbcfe7",
    "terminal_lightteal": "#99E6B3",
    "terminal_pink": "#B86CB3",
    "terminal_red": "#CA5FA6",
    "tertiary_background": "#303751",
    "usage_0": "#CED9FF",
    "usage_1": "#ACB9E6",
    "usage_2": "#CDBBE5",
    "usage_3": "#EA98EE",
    "usage_4": "#F883C9",
    "usage_5": "#FF6F7A"
  },
  "palettes": {
    "template": "{{ if eq .Shell \"pwsh\" }}powershell{{ else }}others{{ end }}",
    "list": {
      "powershell": {
        "os_color": "p:terminal_lightblue"
      },
      "others": {
        "os_color": "p:terminal_bluegray"
      }
    }
  },
  "var": {
    "dot": "\uf444",
    "git_branch_divergence": "\udb80\udc27",
    "git_changes_pending": "\udb82\udd93",
    "git_commits_ahead": "\udb81\udf38",
    "git_commits_behind": "\udb81\udf2f",
    "github": "https://github.com/v-amorim/oh-my-posh"
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "newline": false,
      "segments": [
        {
          "type": "battery",
          "style": "diamond",
          "foreground": "p:main_background",
          "background": "p:main_background",
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4",
          "template": "{{ if not .Error }}{{- if lt .Percentage 10 }}<p:usage_5>\udb80\udc83</>{{- else if lt .Percentage 39 }}<p:usage_4>\udb80\udc7b</>{{- else if lt .Percentage 59 }}<p:usage_3>\udb80\udc7d</>{{- else if lt .Percentage 79 }}<p:usage_2>\udb80\udc7f</>{{- else if lt .Percentage 98 }}<p:usage_1>\udb80\udc81</>{{- else }}<p:usage_0>\udb80\udc79</>{{- end }}{{ end }}"
        },
        {
          "type": "upgrade",
          "style": "diamond",
          "background": "p:secondary_background",
          "foreground": "p:terminal_brightgray",
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4",
          "template": "<f>\udb80\udd62</f>",
          "options": {
            "cache_duration": "168h"
          }
        },
        {
          "type": "session",
          "style": "diamond",
          "background": "p:secondary_background",
          "foreground": "p:terminal_bluegray",
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4",
          "template": "{{ if .SSHSession }}\udb82\udcc0{{ end }}"
        },
        {
          "type": "python",
          "style": "diamond",
          "background": "p:secondary_background",
          "foreground": "p:terminal_lightblue",
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4",
          "template": "\ue235 {{ .Full }}{{ if .Venv }} ({{ .Venv }}){{ end }}{{ if .WSL }} {{ base (dir (dir (dir (stat .Executable)))) }}{{ end }}",
          "options": {
            "cache_duration": "none",
            "fetch_version": true,
            "folder_name_fallback": false,
            "fetch_virtual_env": true,
            "display_default": false
          }
        },
        {
          "type": "git",
          "style": "diamond",
          "background": "p:secondary_background",
          "foreground": "p:terminal_blue",
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4",
          "max_width": 109,
          "templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) (and (gt .Ahead 0) (gt .Behind 0)) (gt .Ahead 0) (gt .Behind 0) }}[{{ if or (.Working.Changed) (.Staging.Changed) }}<p:git_changes_pending>{{.Var.git_changes_pending}}</>{{ end }}{{ if and (gt .Ahead 0) (gt .Behind 0) }}<p:git_branch_divergence>{{.Var.git_branch_divergence}}</>{{ end }}{{ if gt .Ahead 0 }}<p:git_commits_ahead>{{.Var.git_commits_ahead}}</>{{ end }}{{ if gt .Behind 0 }}<p:git_commits_behind>{{.Var.git_commits_behind}}</>{{ end }}]{{ end }}",
            " {{ url .HEAD .UpstreamURL }}"
          ],
          "options": {
            "branch_icon": "\ue725 ",
            "branch_template": "{{ trunc 20 .Branch }}",
            "commit_icon": "\uf417 ",
            "tag_icon": "\uf412 ",
            "merge_icon": "\ue727 ",
            "rebase_icon": "\ue728 ",
            "cherry_pick_icon": "\uf0e2 ",
            "revert_icon": "\uf0e2 ",
            "no_commits_icon": "\uf128 ",
            "branch_gone_icon": "\uea71 ",
            "github_icon": "\uf408 ",
            "gitlab_icon": "\uf296 ",
            "git_icon": "\ue702 ",
            "ignore_submodules": { "*": "all" }
          }
        },
        {
          "type": "executiontime",
          "style": "diamond",
          "background": "p:main_background",
          "foreground": "p:terminal_lightgray",
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4",
          "template": "{{ .FormattedMs }}",
          "options": {
            "style": "austin",
            "threshold": 200
          }
        },
        {
          "type": "status",
          "style": "diamond",
          "background": "p:tertiary_background",
          "foreground": "p:terminal_bluegray",
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4",
          "template": "{{ if ne .Code 0 }}\uf00d {{ reason .Code }}{{ end }}"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "os",
          "style": "diamond",
          "background": "p:main_background",
          "foreground": "p:os_color",
          "leading_diamond": "\ue0b6",
          "template": "{{ if .Root }}<i>{{ url .Icon .Var.github }}</i>{{ else }}{{ url .Icon .Var.github }}{{ end }} ",
          "options": {
            "macos": "\ue711",
            "ubuntu": "\uf31b",
            "windows": "\ue70f"
          }
        },
        {
          "type": "time",
          "style": "diamond",
          "background": "p:main_background",
          "foreground": "p:terminal_gray",
          "trailing_diamond": "\ue0b4",
          "template": "{{ .CurrentDate | date .Format }}",
          "options": {
            "time_format": "15:04"
          }
        },
        {
          "type": "git",
          "style": "diamond",
          "background": "p:secondary_background",
          "foreground": "p:terminal_blue",
          "trailing_diamond": "\ue0b4",
          "min_width": 110,
          "templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) (and (gt .Ahead 0) (gt .Behind 0)) (gt .Ahead 0) (gt .Behind 0) }}[{{ if or (.Working.Changed) (.Staging.Changed) }}<p:git_changes_pending>{{.Var.git_changes_pending}}</>{{ end }}{{ if and (gt .Ahead 0) (gt .Behind 0) }}<p:git_branch_divergence>{{.Var.git_branch_divergence}}</>{{ end }}{{ if gt .Ahead 0 }}<p:git_commits_ahead>{{.Var.git_commits_ahead}}</>{{ end }}{{ if gt .Behind 0 }}<p:git_commits_behind>{{.Var.git_commits_behind}}</>{{ end }}]{{ end }}",
            " {{ url .HEAD .UpstreamURL }}"
          ],
          "options": {
            "branch_icon": "\ue725 ",
            "branch_template": "{{ trunc 20 .Branch }}",
            "commit_icon": "\uf417 ",
            "tag_icon": "\uf412 ",
            "merge_icon": "\ue727 ",
            "rebase_icon": "\ue728 ",
            "cherry_pick_icon": "\uf0e2 ",
            "revert_icon": "\uf0e2 ",
            "no_commits_icon": "\uf128 ",
            "branch_gone_icon": "\uea71 ",
            "github_icon": "\uf408 ",
            "gitlab_icon": "\uf296 ",
            "git_icon": "\ue702 ",
            "ignore_submodules": { "*": "all" }
          }
        },
        {
          "type": "path",
          "style": "diamond",
          "background": "p:tertiary_background",
          "foreground": "p:terminal_bluegray",
          "trailing_diamond": "\ue0b4",
          "template": " {{ path .Path .Location }} ",
          "options": {
            "folder_icon": "\ue5ff",
            "home_icon": "\uf4e2",
            "max_depth": 2,
            "style": "agnoster_short",
            "folder_separator_icon": "  ",
            "hide_root_location": true,
            "cycle": [ "p:terminal_brightgray", "p:terminal_bluegray" ],
            "cycle_folder_separator": true,
            "mapped_locations": {
              "re:(.*/Desktop).*": "\uf108",
              "re:(.*/Documents).*": "\udb80\ude19",
              "re:(.*/Documents/GitHub).*": "\uf408",
              "re:(.*/Documents/My Games).*": "\udb80\ude97",
              "re:(.*/Download[s]?).*": "\udb80\uddda",
              "re:(.*/Download[s]?/qBitTorrent).*": "\udb82\ude08",
              "re:(.*/Pictures).*": "\udb80\udee9",
              "re:(.*/Video[s]?).*": "\uf04b"
            }
          }
        }
      ]
    }
  ],
  "secondary_prompt": {
    "template": "<d>\u279c </d>",
    "background": "transparent",
    "foreground": "p:os_color"
  },
  "transient_prompt": {
    "background": "transparent",
    "foreground": "p:os_color",
    "template": "<p:main_background>\ue0b6</><p:terminal_gray,p:main_background>{{ .Segments.Time.CurrentDate | date .Segments.Time.Format }}</><p:main_background>\ue0b4</>{{ if .Segments.Executiontime.Ms }}<p:main_background>\ue0b6</><p:terminal_lightgray,p:main_background>{{ .Segments.Executiontime.FormattedMs }}</><p:main_background>\ue0b4</> {{ end }}",
    "filler": "<p:os_color><d>\u002d</d></>"
  },
  "upgrade": {
    "notice": true,
    "interval": "168h",
    "auto": false,
    "source": "cdn"
  }
}
